import React, { useEffect, useMemo, useState } from 'react';
import { AlertCircle, Ban, BookOpen, CalendarDays, CheckCircle2, Plus, ReceiptText, Search, Wallet } from 'lucide-react';
import { Expense, Account } from '../../types';
import { ExpenseService, ExpenseInput } from '../../lib/expenseService';
import { useAuth } from '../auth/Auth';
import { Button } from '../ui/Button';
import { Input } from '../ui/Input';
import { Select } from '../ui/Select';
import { Modal } from '../ui/Modal';
import { cn } from '../../lib/utils';

const money=(n:number)=>`Rp ${n.toLocaleString('id-ID')}`;
const today=()=>new Date().toISOString().slice(0,10);
type DraftItem={accountId:string;description:string;quantity:number;unitPrice:number;taxRate:number};

export const ExpenseList:React.FC=()=>{
 const {user,canPerformAction}=useAuth();
 const [expenses,setExpenses]=useState<Expense[]>([]),[accounts,setAccounts]=useState<Account[]>([]),[query,setQuery]=useState(''),[status,setStatus]=useState('ALL'),[paymentStatus,setPaymentStatus]=useState('ALL'),[period,setPeriod]=useState('THIS_MONTH'),[open,setOpen]=useState(false),[saving,setSaving]=useState(false),[error,setError]=useState(''),[selected,setSelected]=useState<Expense|null>(null);
 const [form,setForm]=useState<ExpenseInput>({transactionDate:today(),vendorName:'',description:'',paymentStatus:'PAID',items:[{accountId:'',description:'',quantity:1,unitPrice:0,taxRate:0}]});
 const load=async()=>{const[e,a]=await Promise.all([ExpenseService.list(user?.organizationId),ExpenseService.getAccounts(user?.organizationId)]);setExpenses(e);setAccounts(a);if(!form.items[0]?.accountId&&a[0])setForm(f=>({...f,items:f.items.map((i,idx)=>idx?i:{...i,accountId:a.find(x=>x.type==='EXPENSE')?.id||a[0].id}),paymentAccountId:a.find(x=>x.code==='1-1000')?.id}));};
 useEffect(()=>{load()},[user?.organizationId]);
 const expenseAccounts=accounts.filter(a=>a.type==='EXPENSE'),paymentAccounts=accounts.filter(a=>a.type==='ASSET');
 const totals=useMemo(()=>{const m=new Date().toISOString().slice(0,7),v=expenses.filter(e=>e.transactionDate.slice(0,7)===m&&e.status!=='CANCELLED');return{all:expenses.filter(e=>e.status!=='CANCELLED').reduce((s,e)=>s+e.totalAmount,0),month:v.reduce((s,e)=>s+e.totalAmount,0),unpaid:expenses.filter(e=>e.status!=='CANCELLED'&&e.paymentStatus!=='PAID').reduce((s,e)=>s+e.totalAmount,0),count:expenses.length}},[expenses]);
 const filtered=expenses.filter(e=>{const q=query.toLowerCase(),m=new Date().toISOString().slice(0,7);return(!q||`${e.expenseNumber} ${e.vendorName} ${e.description}`.toLowerCase().includes(q))&&(status==='ALL'||e.status===status)&&(paymentStatus==='ALL'||e.paymentStatus===paymentStatus)&&(period==='ALL'||e.transactionDate.slice(0,7)===m)});
 const reset=()=>{setForm({transactionDate:today(),vendorName:'',description:'',paymentStatus:'PAID',items:[{accountId:expenseAccounts[0]?.id||'',description:'',quantity:1,unitPrice:0,taxRate:0}],paymentAccountId:paymentAccounts.find(a=>a.code==='1-1000')?.id||paymentAccounts[0]?.id});setError('');setOpen(true)};
 const submit=async()=>{if(!user)return;setSaving(true);setError('');try{const s=await ExpenseService.save(form,user.organizationId,user.id);setOpen(false);setSelected(s);await load()}catch(e:any){setError(e?.message||'Pengeluaran gagal disimpan.')}finally{setSaving(false)}};
 const cancel=async()=>{if(!selected||!confirm(`Batalkan ${selected.expenseNumber}? Jurnal akan dibalik, bukan dihapus.`))return;try{await ExpenseService.cancel(selected.id,user?.organizationId); setSelected(null);await load()}catch(e:any){setError(e?.message||'Gagal membatalkan transaksi.')}};
 const updateItem=(idx:number,p:Partial<DraftItem>)=>setForm(f=>({...f,items:f.items.map((it,i)=>i===idx?{...it,...p}:it)}));
 const subtotal=form.items.reduce((s,i)=>s+Math.round(i.quantity*i.unitPrice),0),tax=form.items.reduce((s,i)=>s+Math.round(i.quantity*i.unitPrice*(i.taxRate||0)/100),0),total=subtotal+tax;
 const accountName=(id:string)=>accounts.find(a=>a.id===id)?.name||'-';
 return <div className="space-y-6">
  <div className="flex flex-col sm:flex-row sm:items-end justify-between gap-4"><div><div className="flex items-center gap-2 text-blue-600 text-xs font-bold uppercase tracking-wider"><Wallet className="w-4 h-4"/> Keuangan</div><h1 className="text-2xl font-bold text-slate-900 mt-1">Pengeluaran</h1><p className="text-sm text-slate-500 mt-1">Catat biaya bisnis dan pastikan setiap transaksi memiliki jejak jurnal.</p></div>{canPerformAction('create_draft')&&<Button onClick={reset} className="gap-2"><Plus className="w-4 h-4"/> Pengeluaran Baru</Button>}</div>
  <div className="grid grid-cols-2 lg:grid-cols-4 gap-3">{[['Total Pengeluaran',totals.all,ReceiptText],['Bulan Ini',totals.month,CalendarDays],['Belum Lunas',totals.unpaid,AlertCircle],['Transaksi',totals.count,BookOpen]].map(([l,v,I]:any)=><div key={l} className="bg-white border border-slate-200 rounded-xl p-4 shadow-sm"><div className="flex justify-between"><span className="text-xs font-semibold text-slate-500">{l}</span><I className="w-4 h-4 text-slate-400"/></div><div className="mt-2 text-lg font-bold text-slate-900">{l==='Transaksi'?v:money(v)}</div></div>)}</div>
  <div className="bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden"><div className="p-4 border-b border-slate-100 flex flex-col lg:flex-row gap-3"><div className="flex-1"><Input value={query} onChange={e=>setQuery(e.target.value)} placeholder="Cari nomor, vendor, atau deskripsi..." leftIcon={<Search className="w-4 h-4"/>}/></div><Select value={period} onChange={e=>setPeriod(e.target.value)} options={[{value:'THIS_MONTH',label:'Bulan ini'},{value:'ALL',label:'Semua periode'}]}/><Select value={status} onChange={e=>setStatus(e.target.value)} options={[{value:'ALL',label:'Semua status'},{value:'POSTED',label:'Posted'},{value:'CANCELLED',label:'Dibatalkan'}]}/><Select value={paymentStatus} onChange={e=>setPaymentStatus(e.target.value)} options={[{value:'ALL',label:'Semua pembayaran'},{value:'UNPAID',label:'Belum dibayar'},{value:'PARTIAL',label:'Sebagian'},{value:'PAID',label:'Lunas'}]}/></div><div className="overflow-x-auto"><table className="w-full text-sm"><thead className="bg-slate-50 text-xs text-slate-500 uppercase"><tr><th className="text-left px-5 py-3">Nomor</th><th className="text-left px-5 py-3">Tanggal</th><th className="text-left px-5 py-3">Vendor / Deskripsi</th><th className="text-left px-5 py-3">Status</th><th className="text-right px-5 py-3">Total</th></tr></thead><tbody className="divide-y divide-slate-100">{filtered.map(e=><tr key={e.id} onClick={()=>setSelected(e)} className="hover:bg-slate-50 cursor-pointer"><td className="px-5 py-4 font-semibold text-blue-600">{e.expenseNumber}</td><td className="px-5 py-4 text-slate-600">{new Date(e.transactionDate).toLocaleDateString('id-ID')}</td><td className="px-5 py-4"><div className="font-medium text-slate-800">{e.vendorName||'Tanpa vendor'}</div><div className="text-xs text-slate-500 truncate max-w-xs">{e.description}</div></td><td className="px-5 py-4"><span className={cn('inline-flex items-center gap-1 px-2 py-1 rounded-full text-xs font-semibold',e.status==='CANCELLED'?'bg-rose-50 text-rose-700':'bg-emerald-50 text-emerald-700')}>{e.status==='CANCELLED'?<Ban className="w-3 h-3"/>:<CheckCircle2 className="w-3 h-3"/>}{e.status}</span><div className="text-[11px] text-slate-500 mt-1">{e.paymentStatus}</div></td><td className="px-5 py-4 text-right font-bold">{money(e.totalAmount)}</td></tr>)}{!filtered.length&&<tr><td colSpan={5} className="px-5 py-14 text-center text-slate-500">Belum ada transaksi yang sesuai filter.</td></tr>}</tbody></table></div></div>
  <Modal isOpen={open} onClose={()=>!saving&&setOpen(false)} title="Pengeluaran Baru" maxWidth="4xl"><div className="space-y-5">{error&&<div className="p-3 rounded-lg bg-rose-50 border border-rose-200 text-sm text-rose-700">{error}</div>}<div className="grid grid-cols-1 md:grid-cols-2 gap-4"><Input label="Tanggal" type="date" value={form.transactionDate} onChange={e=>setForm(f=>({...f,transactionDate:e.target.value}))}/><Input label="Vendor / Penerima" value={form.vendorName||''} onChange={e=>setForm(f=>({...f,vendorName:e.target.value}))}/><Input label="Deskripsi" value={form.description} onChange={e=>setForm(f=>({...f,description:e.target.value}))}/><Input label="Jatuh Tempo (opsional)" type="date" value={form.dueDate||''} onChange={e=>setForm(f=>({...f,dueDate:e.target.value||undefined}))}/></div><div className="border border-slate-200 rounded-xl overflow-hidden"><div className="px-4 py-3 bg-slate-50 font-semibold text-sm">Rincian Biaya</div>{form.items.map((item,idx)=><div key={idx} className="p-4 border-t grid grid-cols-1 md:grid-cols-12 gap-3"><div className="md:col-span-4"><Select label="Akun Biaya" value={item.accountId} onChange={e=>updateItem(idx,{accountId:e.target.value})} options={expenseAccounts.map(a=>({value:a.id,label:`${a.code} — ${a.name}`}))}/></div><div className="md:col-span-3"><Input label="Keterangan" value={item.description} onChange={e=>updateItem(idx,{description:e.target.value})}/></div><div className="md:col-span-2"><Input label="Qty" type="number" min="0.01" value={item.quantity} onChange={e=>updateItem(idx,{quantity:Number(e.target.value)})}/></div><div className="md:col-span-3"><Input label="Harga" type="number" min="0" value={item.unitPrice} onChange={e=>updateItem(idx,{unitPrice:Number(e.target.value)})}/></div></div>)}<div className="px-4 py-3 border-t bg-slate-50 flex justify-end"><div className="w-full md:w-80 space-y-1 text-sm"><div className="flex justify-between"><span>Subtotal</span><b>{money(subtotal)}</b></div><div className="flex justify-between"><span>Pajak</span><b>{money(tax)}</b></div><div className="flex justify-between text-base pt-2 border-t"><span>Total</span><b>{money(total)}</b></div></div></div></div><div className="grid grid-cols-1 md:grid-cols-2 gap-4"><Select label="Status Pembayaran" value={form.paymentStatus} onChange={e=>setForm(f=>({...f,paymentStatus:e.target.value as any}))} options={[{value:'PAID',label:'Lunas / langsung dibayar'},{value:'UNPAID',label:'Belum dibayar / menjadi hutang'}]}/>{form.paymentStatus!=='UNPAID'&&<Select label="Akun Pembayaran" value={form.paymentAccountId||''} onChange={e=>setForm(f=>({...f,paymentAccountId:e.target.value}))} options={paymentAccounts.map(a=>({value:a.id,label:`${a.code} — ${a.name}`}))}/>}</div><Input label="Catatan" value={form.notes||''} onChange={e=>setForm(f=>({...f,notes:e.target.value}))}/><div className="flex justify-end gap-2"><Button variant="secondary" onClick={()=>setOpen(false)} disabled={saving}>Batal</Button><Button onClick={submit} disabled={saving||total<=0}>{saving?'Menyimpan...':'Simpan & Posting'}</Button></div></div></Modal>
  <Modal isOpen={!!selected} onClose={()=>setSelected(null)} title={selected?.expenseNumber||'Detail Pengeluaran'} maxWidth="3xl">{selected&&<div className="space-y-5"><div className="grid grid-cols-2 gap-4"><div><p className="text-xs text-slate-500">Tanggal</p><p className="font-semibold">{new Date(selected.transactionDate).toLocaleDateString('id-ID')}</p></div><div><p className="text-xs text-slate-500">Vendor</p><p className="font-semibold">{selected.vendorName||'-'}</p></div><div><p className="text-xs text-slate-500">Status</p><p className="font-semibold">{selected.status} · {selected.paymentStatus}</p></div><div><p className="text-xs text-slate-500">Total</p><p className="text-xl font-bold">{money(selected.totalAmount)}</p></div></div><div><h3 className="font-semibold text-sm mb-2">Rincian</h3><div className="border rounded-lg divide-y">{selected.items.map(i=><div className="p-3 flex justify-between" key={i.id}><div><div className="font-medium">{accountName(i.accountId)}</div><div className="text-xs text-slate-500">{i.description||'Tanpa keterangan'}</div></div><div className="font-semibold">{money(i.lineTotal+i.taxAmount)}</div></div>)}</div></div>{selected.journal&&<div className="bg-slate-50 rounded-xl p-4"><div className="flex items-center gap-2 font-semibold mb-3"><BookOpen className="w-4 h-4"/> Jurnal {selected.journal.journalNumber}<span className="ml-auto text-xs text-emerald-700">BALANCED</span></div>{selected.journal.lines.map((l,i)=><div key={i} className="grid grid-cols-3 text-sm py-1"><span>{accountName(l.accountId)}</span><span className="text-right">{l.debit?money(l.debit):'-'}</span><span className="text-right">{l.credit?money(l.credit):'-'}</span></div>)}</div>}{selected.status!=='CANCELLED'&&canPerformAction('delete_records')&&<div className="flex justify-end"><Button variant="secondary" onClick={cancel} className="text-rose-700"><Ban className="w-4 h-4 mr-2"/> Batalkan & Balik Jurnal</Button></div>}</div>}</Modal>
 </div>;
};
